# ============================================================
# Cyber Asset Management Platform — Environment Variables
# ============================================================

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cyber_management
POSTGRES_USER=cyber_admin
POSTGRES_PASSWORD=StrongPostgresPass!2024

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=StrongRedisPass!2024

# --- Neo4j ---
NEO4J_HOST=neo4j
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=StrongNeo4jPass!2024

# --- JWT ---
JWT_SECRET=your-super-secret-jwt-key-minimum-32-chars!!
JWT_ISSUER=CyberManagementPlatform
JWT_AUDIENCE=CyberManagementUsers
JWT_EXPIRY_HOURS=8

# --- Backend API ---
BACKEND_PORT=5000
ASPNETCORE_ENVIRONMENT=Production

# --- Discovery Engine ---
DISCOVERY_ENGINE_PORT=8001
DISCOVERY_ENGINE_SECRET=discovery-engine-secret-key

# --- GLPI ---
GLPI_URL=http://your-glpi-server/apirest.php
GLPI_APP_TOKEN=your-glpi-app-token
GLPI_USER_TOKEN=your-glpi-user-token

# --- SIEM ---
SIEM_SYSLOG_HOST=your-siem-host
SIEM_SYSLOG_PORT=514
SIEM_WEBHOOK_URL=http://your-siem/webhook
SIEM_ENABLED=false

# --- Frontend ---
VITE_API_BASE_URL=http://localhost/api
VITE_APP_NAME=سامانه مدیریت دارایی‌های سایبری
